{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "EveryMail",
	"version": "0.1.0",
	"identifier": "dev.everyai.everymail",
	"build": {
		"devUrl": "http://localhost:5173",
		"frontendDist": "../frontend/dist",
		"beforeDevCommand": "bun run --cwd frontend dev",
		"beforeBuildCommand": "bun run --cwd frontend build"
	},
	"app": {
		"windows": [{ "title": "EveryMail" }],
		"security": {
			"csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/128x128@2x.png",
			"icons/128x128.png",
			"icons/32x32.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
